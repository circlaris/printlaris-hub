# Install on the Pi (after `composer install --no-dev` and copying .env.example to .env with `php artisan key:generate`):
#   sudo cp deploy/printlaris-*.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now printlaris-web printlaris-runner printlaris-scheduler
# The web UI is plain HTTP on the local network; do not expose port 8080 beyond it.

[Unit]
Description=Printlaris Hub web interface
After=network-online.target

[Service]
Type=simple
User=printlaris
Group=printlaris
WorkingDirectory=/opt/printlaris-hub
Environment=PHP_CLI_SERVER_WORKERS=2
ExecStart=/usr/bin/php artisan serve --host=0.0.0.0 --port=8080
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
