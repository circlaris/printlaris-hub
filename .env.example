APP_NAME="Circlaris Printing Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://printlaris.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=array

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

PRINTLARIS_ENDPOINT=https://app.circlaris.com/printlaris/client

# Label printer discovery: TLS raw port and optional comma-separated CIDRs (default: the hub's own subnets)
# PRINTLARIS_ZEBRA_PORT=9143
# PRINTLARIS_DISCOVERY_SUBNETS=
VITE_APP_NAME="${APP_NAME}"
